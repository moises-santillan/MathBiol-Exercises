\newlabel{ch20}{{20}{135}{}{chapter.20}{}}
\@writefile{toc}{\contentsline {section}{\numberline {20.1}Introduction}{135}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {20.2}The Hodgkin-Huxley Model}{136}{}\protected@file@percent }
\newlabel{fig:20.01}{{20.2}{137}{}{section.20.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20.1}{\ignorespaces Equivalent circuit diagram of the Hodgkin-Huxley model. The membrane is represented as a capacitor separating two ionic solutions of different concentration. Conductances for sodium ($g_{Na}$), potassium ($g_{K}$) and leak ($g_{L}$) currents are modeled as variable resistors in parallel with the membrane. Reversal potentials ($V_{Na}$, $V_{K}$, $V_{L}$) drive ion flow down electrochemical gradients.}}{137}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {20.3}Motivation for Simplification}{138}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {20.4}Derivation of the FitzHugh-Nagumo Equations}{138}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {20.5}Analysis of Steady States}{139}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20.2}{\ignorespaces Nullcline diagrams of the FitzHugh-Nagumo system for different values of the input current $I$. When $I=0$ and $I=1$, the cubic $V$-nullcline intersects the linear $R$-nullcline in the left branch where $f'(V)<0$, yielding a stable fixed point. For $I=2$, the intersection occurs in the middle branch where $f'(V)>0$, producing an unstable fixed point.}}{140}{}\protected@file@percent }
\newlabel{fig:20.02}{{20.2}{140}{}{figure.20.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {20.6}Phase Plane Analysis}{141}{}\protected@file@percent }
\newlabel{fig:20.03}{{20.6}{141}{}{subfigure.20.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20.3}{\ignorespaces Phase portraits of the FitzHugh-Nagumo oscillator for parameter values $a=1$, $b=3$, $\gamma =2$, and 2 different values of parameter $\epsilon $, overlaid with nullclines. Arrows indicate vector field flow.}}{141}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {20.7}Relaxation oscillator behavior}{142}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {20.8}Applications to Excitable Systems}{142}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20.4}{\ignorespaces Phase portrait for $\gamma \ll 1$ illustrating relaxation oscillations. Thick green lines trace the limit cycle trajectory, rapidly switching between lateral branches of the $V$-nullcline at local minima/maxima and slowly creeping along branches. Arrows indicate vector field flow. During rapid excursions, the membrane potential spikes, while the slower recovery variable $R$ modulates the falling and rising phases.}}{143}{}\protected@file@percent }
\newlabel{fig:20.04}{{20.4}{143}{}{figure.20.4}{}}
